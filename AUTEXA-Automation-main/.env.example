# Postgres DB Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=autexa

# AI Agents
GEMINI_API_KEY=your_gemini_api_key_here

# Redis (used by worker-service / Celery)
REDIS_URL=redis://localhost:6379/0

# n8n hot-lead webhook URL (set after importing workflow into n8n)
N8N_WEBHOOK_URL=http://n8n:5678/webhook/hot-lead
N8N_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# n8n dashboard credentials
N8N_USER=admin
N8N_PASSWORD=autexa_n8n

# WhatsApp Cloud API (sandbox — get from Meta Developer Console)
# https://developers.facebook.com/apps/ → WhatsApp → API Setup
WHATSAPP_VERIFY_TOKEN=autexa_verify_token
WHATSAPP_ACCESS_TOKEN=your_whatsapp_cloud_api_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
